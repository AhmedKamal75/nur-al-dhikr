{
  "name": "nur-al-dhikr",
  "version": "5.2.6",
  "description": "An offline-first, installable web app for daily Islamic remembrance — Adhkar, Duas, the 99 Names of Allah, prayer times, a Hijri calendar, a tasbih counter, the complete Qur'an with per-word study, and per-tab options menus.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,css,html,json,md}\" --ignore-path .prettierignore",
    "test": "node --test tests/*.test.js",
    "e2e": "playwright test",
    "snapshot-shell": "node scripts/snapshot-shell.mjs",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
  "author": ""
}
