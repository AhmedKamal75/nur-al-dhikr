{"key":"fr-hamidullah","surah":104,"ayahs":[{"number":1,"translation":"Malheur à tout calomniateur diffamateur"},{"number":2,"translation":"qui amasse une fortune et la compte"},{"number":3,"translation":"pensant que sa fortune l'immortalisera"},{"number":4,"translation":"Mais non! Il sera certes, jeté dans la Hutamah"},{"number":5,"translation":"Et qui te dira ce qu'est la Hutamah"},{"number":6,"translation":"Le Feu attisé d'Allah"},{"number":7,"translation":"qui monte jusqu'aux cœurs"},{"number":8,"translation":"Il se refermera sur eux"},{"number":9,"translation":"en colonnes (de flammes) étendues"}]}
