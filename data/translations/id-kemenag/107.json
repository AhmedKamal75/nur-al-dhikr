{"key":"id-kemenag","surah":107,"ayahs":[{"number":1,"translation":"Tahukah kamu (orang) yang mendustakan agama"},{"number":2,"translation":"Maka itulah orang yang menghardik anak yatim"},{"number":3,"translation":"dan tidak mengajak memberi makan orang miskin"},{"number":4,"translation":"Maka celakalah orang yang salat"},{"number":5,"translation":"(yaitu) orang-orang yang lalai terhadap salatnya"},{"number":6,"translation":"yang berbuat riya"},{"number":7,"translation":"dan enggan (memberikan) bantuan"}]}
