{"key":"id-kemenag","surah":114,"ayahs":[{"number":1,"translation":"Katakanlah, \"Aku berlindung kepada Tuhannya manusia"},{"number":2,"translation":"Raja manusia"},{"number":3,"translation":"sembahan manusia"},{"number":4,"translation":"dari kejahatan (bisikan) setan yang bersembunyi"},{"number":5,"translation":"yang membisikkan (kejahatan) ke dalam dada manusia"},{"number":6,"translation":"dari (golongan) jin dan manusia"}]}
