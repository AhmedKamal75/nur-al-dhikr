{"page":531,"juz":27,"chapters":[{"number":54,"titleEn":"Al-Qamar","titleAr":"القمر","verseCount":55,"startsHere":false,"verses":[{"number":50,"text":"وَمَآ أَمْرُنَآ إِلَّا وَٰحِدَةٌ كَلَمْحٍۭ بِٱلْبَصَرِ"},{"number":51,"text":"وَلَقَدْ أَهْلَكْنَآ أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرٍ"},{"number":52,"text":"وَكُلُّ شَىْءٍ فَعَلُوهُ فِى ٱلزُّبُرِ"},{"number":53,"text":"وَكُلُّ صَغِيرٍ وَكَبِيرٍ مُّسْتَطَرٌ"},{"number":54,"text":"إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَنَهَرٍ"},{"number":55,"text":"فِى مَقْعَدِ صِدْقٍ عِندَ مَلِيكٍ مُّقْتَدِرٍۭ"}]},{"number":55,"titleEn":"Ar-Rahman","titleAr":"الرحمن","verseCount":78,"startsHere":true,"verses":[{"number":1,"text":" ٱلرَّحْمَـٰنُ"},{"number":2,"text":"عَلَّمَ ٱلْقُرْءَانَ"},{"number":3,"text":"خَلَقَ ٱلْإِنسَـٰنَ"},{"number":4,"text":"عَلَّمَهُ ٱلْبَيَانَ"},{"number":5,"text":"ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ"},{"number":6,"text":"وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ"},{"number":7,"text":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ"},{"number":8,"text":"أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ"},{"number":9,"text":"وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ"},{"number":10,"text":"وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ"},{"number":11,"text":"فِيهَا فَـٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ"},{"number":12,"text":"وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ"},{"number":13,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":14,"text":"خَلَقَ ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍ كَٱلْفَخَّارِ"},{"number":15,"text":"وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ"},{"number":16,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}]}]}