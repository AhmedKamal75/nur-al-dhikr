{"page":577,"juz":29,"chapters":[{"number":74,"titleEn":"Al-Muddaththir","titleAr":"المدثر","verseCount":56,"startsHere":false,"verses":[{"number":48,"text":"فَمَا تَنفَعُهُمْ شَفَـٰعَةُ ٱلشَّـٰفِعِينَ"},{"number":49,"text":"فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ"},{"number":50,"text":"كَأَنَّهُمْ حُمُرٌ مُّسْتَنفِرَةٌ"},{"number":51,"text":"فَرَّتْ مِن قَسْوَرَةٍۭ"},{"number":52,"text":"بَلْ يُرِيدُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًا مُّنَشَّرَةً"},{"number":53,"text":"كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْـَٔاخِرَةَ"},{"number":54,"text":"كَلَّآ إِنَّهُۥ تَذْكِرَةٌ"},{"number":55,"text":"فَمَن شَآءَ ذَكَرَهُۥ"},{"number":56,"text":"وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ"}]},{"number":75,"titleEn":"Al-Qiyamah","titleAr":"القيامة","verseCount":40,"startsHere":true,"verses":[{"number":1,"text":" لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ"},{"number":2,"text":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ"},{"number":3,"text":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"},{"number":4,"text":"بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ"},{"number":5,"text":"بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ"},{"number":6,"text":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ"},{"number":7,"text":"فَإِذَا بَرِقَ ٱلْبَصَرُ"},{"number":8,"text":"وَخَسَفَ ٱلْقَمَرُ"},{"number":9,"text":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ"},{"number":10,"text":"يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ"},{"number":11,"text":"كَلَّا لَا وَزَرَ"},{"number":12,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ"},{"number":13,"text":"يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ"},{"number":14,"text":"بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ"},{"number":15,"text":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ"},{"number":16,"text":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ"},{"number":17,"text":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ"},{"number":18,"text":"فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ"},{"number":19,"text":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ"}]}]}