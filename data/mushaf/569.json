{"page":569,"juz":29,"chapters":[{"number":70,"titleEn":"Al-Ma'arij","titleAr":"المعارج","verseCount":44,"startsHere":false,"verses":[{"number":11,"text":"يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ"},{"number":12,"text":"وَصَـٰحِبَتِهِۦ وَأَخِيهِ"},{"number":13,"text":"وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ"},{"number":14,"text":"وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ"},{"number":15,"text":"كَلَّآ ۖ إِنَّهَا لَظَىٰ"},{"number":16,"text":"نَزَّاعَةً لِّلشَّوَىٰ"},{"number":17,"text":"تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ"},{"number":18,"text":"وَجَمَعَ فَأَوْعَىٰٓ"},{"number":19,"text":"۞ إِنَّ ٱلْإِنسَـٰنَ خُلِقَ هَلُوعًا"},{"number":20,"text":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا"},{"number":21,"text":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا"},{"number":22,"text":"إِلَّا ٱلْمُصَلِّينَ"},{"number":23,"text":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ"},{"number":24,"text":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ"},{"number":25,"text":"لِّلسَّآئِلِ وَٱلْمَحْرُومِ"},{"number":26,"text":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ"},{"number":27,"text":"وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ"},{"number":28,"text":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ"},{"number":29,"text":"وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ"},{"number":30,"text":"إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ"},{"number":31,"text":"فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ"},{"number":32,"text":"وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ"},{"number":33,"text":"وَٱلَّذِينَ هُم بِشَهَـٰدَٰتِهِمْ قَآئِمُونَ"},{"number":34,"text":"وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ"},{"number":35,"text":"أُو۟لَـٰٓئِكَ فِى جَنَّـٰتٍ مُّكْرَمُونَ"},{"number":36,"text":"فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ"},{"number":37,"text":"عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ"},{"number":38,"text":"أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ"},{"number":39,"text":"كَلَّآ ۖ إِنَّا خَلَقْنَـٰهُم مِّمَّا يَعْلَمُونَ"}]}]}