{"page":587,"juz":30,"chapters":[{"number":82,"titleEn":"Al-Infitar","titleAr":"الإنفطار","verseCount":19,"startsHere":true,"verses":[{"number":1,"text":" إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ"},{"number":2,"text":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ"},{"number":3,"text":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ"},{"number":4,"text":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ"},{"number":5,"text":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ"},{"number":6,"text":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ"},{"number":7,"text":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ"},{"number":8,"text":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ"},{"number":9,"text":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ"},{"number":10,"text":"وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ"},{"number":11,"text":"كِرَامًا كَـٰتِبِينَ"},{"number":12,"text":"يَعْلَمُونَ مَا تَفْعَلُونَ"},{"number":13,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ"},{"number":14,"text":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ"},{"number":15,"text":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ"},{"number":16,"text":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ"},{"number":17,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"},{"number":18,"text":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"},{"number":19,"text":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ"}]},{"number":83,"titleEn":"Al-Mutaffifin","titleAr":"المطففين","verseCount":36,"startsHere":true,"verses":[{"number":1,"text":" وَيْلٌ لِّلْمُطَفِّفِينَ"},{"number":2,"text":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ"},{"number":3,"text":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ"},{"number":4,"text":"أَلَا يَظُنُّ أُو۟لَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ"},{"number":5,"text":"لِيَوْمٍ عَظِيمٍ"},{"number":6,"text":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَـٰلَمِينَ"}]}]}