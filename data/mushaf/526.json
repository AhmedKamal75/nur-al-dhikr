{"page":526,"juz":27,"chapters":[{"number":53,"titleEn":"An-Najm","titleAr":"النجم","verseCount":62,"startsHere":true,"verses":[{"number":1,"text":" وَٱلنَّجْمِ إِذَا هَوَىٰ"},{"number":2,"text":"مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ"},{"number":3,"text":"وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ"},{"number":4,"text":"إِنْ هُوَ إِلَّا وَحْىٌ يُوحَىٰ"},{"number":5,"text":"عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ"},{"number":6,"text":"ذُو مِرَّةٍ فَٱسْتَوَىٰ"},{"number":7,"text":"وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ"},{"number":8,"text":"ثُمَّ دَنَا فَتَدَلَّىٰ"},{"number":9,"text":"فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ"},{"number":10,"text":"فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ"},{"number":11,"text":"مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ"},{"number":12,"text":"أَفَتُمَـٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ"},{"number":13,"text":"وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ"},{"number":14,"text":"عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ"},{"number":15,"text":"عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ"},{"number":16,"text":"إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ"},{"number":17,"text":"مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ"},{"number":18,"text":"لَقَدْ رَأَىٰ مِنْ ءَايَـٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ"},{"number":19,"text":"أَفَرَءَيْتُمُ ٱللَّـٰتَ وَٱلْعُزَّىٰ"},{"number":20,"text":"وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ"},{"number":21,"text":"أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ"},{"number":22,"text":"تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰٓ"},{"number":23,"text":"إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَـٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ"},{"number":24,"text":"أَمْ لِلْإِنسَـٰنِ مَا تَمَنَّىٰ"},{"number":25,"text":"فَلِلَّهِ ٱلْـَٔاخِرَةُ وَٱلْأُولَىٰ"},{"number":26,"text":"۞ وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَـٰوَٰتِ لَا تُغْنِى شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ"}]}]}