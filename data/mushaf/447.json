{"page":447,"juz":23,"chapters":[{"number":37,"titleEn":"As-Saffat","titleAr":"الصافات","verseCount":182,"startsHere":false,"verses":[{"number":25,"text":"مَا لَكُمْ لَا تَنَاصَرُونَ"},{"number":26,"text":"بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ"},{"number":27,"text":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"},{"number":28,"text":"قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ"},{"number":29,"text":"قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ"},{"number":30,"text":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَـٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًا طَـٰغِينَ"},{"number":31,"text":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ"},{"number":32,"text":"فَأَغْوَيْنَـٰكُمْ إِنَّا كُنَّا غَـٰوِينَ"},{"number":33,"text":"فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ"},{"number":34,"text":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"},{"number":35,"text":"إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَـٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ"},{"number":36,"text":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ"},{"number":37,"text":"بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ"},{"number":38,"text":"إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ"},{"number":39,"text":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ"},{"number":40,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"number":41,"text":"أُو۟لَـٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ"},{"number":42,"text":"فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ"},{"number":43,"text":"فِى جَنَّـٰتِ ٱلنَّعِيمِ"},{"number":44,"text":"عَلَىٰ سُرُرٍ مُّتَقَـٰبِلِينَ"},{"number":45,"text":"يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ"},{"number":46,"text":"بَيْضَآءَ لَذَّةٍ لِّلشَّـٰرِبِينَ"},{"number":47,"text":"لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ"},{"number":48,"text":"وَعِندَهُمْ قَـٰصِرَٰتُ ٱلطَّرْفِ عِينٌ"},{"number":49,"text":"كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ"},{"number":50,"text":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"},{"number":51,"text":"قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ"}]}]}