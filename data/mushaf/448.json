{"page":448,"juz":23,"chapters":[{"number":37,"titleEn":"As-Saffat","titleAr":"الصافات","verseCount":182,"startsHere":false,"verses":[{"number":52,"text":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ"},{"number":53,"text":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَدِينُونَ"},{"number":54,"text":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ"},{"number":55,"text":"فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ"},{"number":56,"text":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ"},{"number":57,"text":"وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ"},{"number":58,"text":"أَفَمَا نَحْنُ بِمَيِّتِينَ"},{"number":59,"text":"إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ"},{"number":60,"text":"إِنَّ هَـٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ"},{"number":61,"text":"لِمِثْلِ هَـٰذَا فَلْيَعْمَلِ ٱلْعَـٰمِلُونَ"},{"number":62,"text":"أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ"},{"number":63,"text":"إِنَّا جَعَلْنَـٰهَا فِتْنَةً لِّلظَّـٰلِمِينَ"},{"number":64,"text":"إِنَّهَا شَجَرَةٌ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ"},{"number":65,"text":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَـٰطِينِ"},{"number":66,"text":"فَإِنَّهُمْ لَـَٔاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ"},{"number":67,"text":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ"},{"number":68,"text":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ"},{"number":69,"text":"إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ"},{"number":70,"text":"فَهُمْ عَلَىٰٓ ءَاثَـٰرِهِمْ يُهْرَعُونَ"},{"number":71,"text":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ"},{"number":72,"text":"وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ"},{"number":73,"text":"فَٱنظُرْ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُنذَرِينَ"},{"number":74,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"number":75,"text":"وَلَقَدْ نَادَىٰنَا نُوحٌ فَلَنِعْمَ ٱلْمُجِيبُونَ"},{"number":76,"text":"وَنَجَّيْنَـٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ"}]}]}