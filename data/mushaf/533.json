{"page":533,"juz":27,"chapters":[{"number":55,"titleEn":"Ar-Rahman","titleAr":"الرحمن","verseCount":78,"startsHere":false,"verses":[{"number":41,"text":"يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَـٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ"},{"number":42,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":43,"text":"هَـٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ"},{"number":44,"text":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍ"},{"number":45,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":46,"text":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ"},{"number":47,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":48,"text":"ذَوَاتَآ أَفْنَانٍ"},{"number":49,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":50,"text":"فِيهِمَا عَيْنَانِ تَجْرِيَانِ"},{"number":51,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":52,"text":"فِيهِمَا مِن كُلِّ فَـٰكِهَةٍ زَوْجَانِ"},{"number":53,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":54,"text":"مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍ ۚ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍ"},{"number":55,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":56,"text":"فِيهِنَّ قَـٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ"},{"number":57,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":58,"text":"كَأَنَّهُنَّ ٱلْيَاقُوتُ وَٱلْمَرْجَانُ"},{"number":59,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":60,"text":"هَلْ جَزَآءُ ٱلْإِحْسَـٰنِ إِلَّا ٱلْإِحْسَـٰنُ"},{"number":61,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":62,"text":"وَمِن دُونِهِمَا جَنَّتَانِ"},{"number":63,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":64,"text":"مُدْهَآمَّتَانِ"},{"number":65,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":66,"text":"فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ"},{"number":67,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}]}]}