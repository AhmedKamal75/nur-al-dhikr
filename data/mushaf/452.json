{"page":452,"juz":23,"chapters":[{"number":37,"titleEn":"As-Saffat","titleAr":"الصافات","verseCount":182,"startsHere":false,"verses":[{"number":154,"text":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ"},{"number":155,"text":"أَفَلَا تَذَكَّرُونَ"},{"number":156,"text":"أَمْ لَكُمْ سُلْطَـٰنٌ مُّبِينٌ"},{"number":157,"text":"فَأْتُوا۟ بِكِتَـٰبِكُمْ إِن كُنتُمْ صَـٰدِقِينَ"},{"number":158,"text":"وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًا ۚ وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ"},{"number":159,"text":"سُبْحَـٰنَ ٱللَّهِ عَمَّا يَصِفُونَ"},{"number":160,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"number":161,"text":"فَإِنَّكُمْ وَمَا تَعْبُدُونَ"},{"number":162,"text":"مَآ أَنتُمْ عَلَيْهِ بِفَـٰتِنِينَ"},{"number":163,"text":"إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ"},{"number":164,"text":"وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌ مَّعْلُومٌ"},{"number":165,"text":"وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ"},{"number":166,"text":"وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ"},{"number":167,"text":"وَإِن كَانُوا۟ لَيَقُولُونَ"},{"number":168,"text":"لَوْ أَنَّ عِندَنَا ذِكْرًا مِّنَ ٱلْأَوَّلِينَ"},{"number":169,"text":"لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"number":170,"text":"فَكَفَرُوا۟ بِهِۦ ۖ فَسَوْفَ يَعْلَمُونَ"},{"number":171,"text":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ"},{"number":172,"text":"إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ"},{"number":173,"text":"وَإِنَّ جُندَنَا لَهُمُ ٱلْغَـٰلِبُونَ"},{"number":174,"text":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},{"number":175,"text":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ"},{"number":176,"text":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"},{"number":177,"text":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ"},{"number":178,"text":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},{"number":179,"text":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ"},{"number":180,"text":"سُبْحَـٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ"},{"number":181,"text":"وَسَلَـٰمٌ عَلَى ٱلْمُرْسَلِينَ"},{"number":182,"text":"وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ"}]}]}