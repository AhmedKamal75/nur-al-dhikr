{"page":604,"juz":30,"chapters":[{"number":112,"titleEn":"Al-Ikhlas","titleAr":"الإخلاص","verseCount":4,"startsHere":true,"verses":[{"number":1,"text":" قُلْ هُوَ ٱللَّهُ أَحَدٌ"},{"number":2,"text":"ٱللَّهُ ٱلصَّمَدُ"},{"number":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ"},{"number":4,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ"}]},{"number":113,"titleEn":"Al-Falaq","titleAr":"الفلق","verseCount":5,"startsHere":true,"verses":[{"number":1,"text":" قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ"},{"number":2,"text":"مِن شَرِّ مَا خَلَقَ"},{"number":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"},{"number":4,"text":"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ"},{"number":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"}]},{"number":114,"titleEn":"An-Nas","titleAr":"الناس","verseCount":6,"startsHere":true,"verses":[{"number":1,"text":" قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ"},{"number":2,"text":"مَلِكِ ٱلنَّاسِ"},{"number":3,"text":"إِلَـٰهِ ٱلنَّاسِ"},{"number":4,"text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ"},{"number":5,"text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ"},{"number":6,"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ"}]}]}