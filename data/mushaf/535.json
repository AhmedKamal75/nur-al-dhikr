{"page":535,"juz":27,"chapters":[{"number":56,"titleEn":"Al-Waqia","titleAr":"الواقعة","verseCount":96,"startsHere":false,"verses":[{"number":17,"text":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ"},{"number":18,"text":"بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ"},{"number":19,"text":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ"},{"number":20,"text":"وَفَـٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ"},{"number":21,"text":"وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ"},{"number":22,"text":"وَحُورٌ عِينٌ"},{"number":23,"text":"كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ"},{"number":24,"text":"جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ"},{"number":25,"text":"لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا"},{"number":26,"text":"إِلَّا قِيلًا سَلَـٰمًا سَلَـٰمًا"},{"number":27,"text":"وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ"},{"number":28,"text":"فِى سِدْرٍ مَّخْضُودٍ"},{"number":29,"text":"وَطَلْحٍ مَّنضُودٍ"},{"number":30,"text":"وَظِلٍّ مَّمْدُودٍ"},{"number":31,"text":"وَمَآءٍ مَّسْكُوبٍ"},{"number":32,"text":"وَفَـٰكِهَةٍ كَثِيرَةٍ"},{"number":33,"text":"لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ"},{"number":34,"text":"وَفُرُشٍ مَّرْفُوعَةٍ"},{"number":35,"text":"إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءً"},{"number":36,"text":"فَجَعَلْنَـٰهُنَّ أَبْكَارًا"},{"number":37,"text":"عُرُبًا أَتْرَابًا"},{"number":38,"text":"لِّأَصْحَـٰبِ ٱلْيَمِينِ"},{"number":39,"text":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ"},{"number":40,"text":"وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ"},{"number":41,"text":"وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ"},{"number":42,"text":"فِى سَمُومٍ وَحَمِيمٍ"},{"number":43,"text":"وَظِلٍّ مِّن يَحْمُومٍ"},{"number":44,"text":"لَّا بَارِدٍ وَلَا كَرِيمٍ"},{"number":45,"text":"إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ"},{"number":46,"text":"وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ"},{"number":47,"text":"وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ"},{"number":48,"text":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ"},{"number":49,"text":"قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ"},{"number":50,"text":"لَمَجْمُوعُونَ إِلَىٰ مِيقَـٰتِ يَوْمٍ مَّعْلُومٍ"}]}]}