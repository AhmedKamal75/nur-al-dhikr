{"page":581,"juz":29,"chapters":[{"number":77,"titleEn":"Al-Mursalat","titleAr":"المرسلات","verseCount":50,"startsHere":false,"verses":[{"number":20,"text":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ"},{"number":21,"text":"فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ"},{"number":22,"text":"إِلَىٰ قَدَرٍ مَّعْلُومٍ"},{"number":23,"text":"فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ"},{"number":24,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"number":25,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا"},{"number":26,"text":"أَحْيَآءً وَأَمْوَٰتًا"},{"number":27,"text":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا"},{"number":28,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"number":29,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"},{"number":30,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ"},{"number":31,"text":"لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ"},{"number":32,"text":"إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ"},{"number":33,"text":"كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ"},{"number":34,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"number":35,"text":"هَـٰذَا يَوْمُ لَا يَنطِقُونَ"},{"number":36,"text":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"},{"number":37,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"number":38,"text":"هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ"},{"number":39,"text":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ"},{"number":40,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"number":41,"text":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ"},{"number":42,"text":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ"},{"number":43,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ"},{"number":44,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"number":45,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"number":46,"text":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ"},{"number":47,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"number":48,"text":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ"},{"number":49,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"number":50,"text":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ"}]}]}