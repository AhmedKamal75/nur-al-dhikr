{"page":578,"juz":29,"chapters":[{"number":75,"titleEn":"Al-Qiyamah","titleAr":"القيامة","verseCount":40,"startsHere":false,"verses":[{"number":20,"text":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ"},{"number":21,"text":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ"},{"number":22,"text":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ"},{"number":23,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٌ"},{"number":24,"text":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ"},{"number":25,"text":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ"},{"number":26,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ"},{"number":27,"text":"وَقِيلَ مَنْ ۜ رَاقٍ"},{"number":28,"text":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ"},{"number":29,"text":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"},{"number":30,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ"},{"number":31,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ"},{"number":32,"text":"وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ"},{"number":33,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ"},{"number":34,"text":"أَوْلَىٰ لَكَ فَأَوْلَىٰ"},{"number":35,"text":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"},{"number":36,"text":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى"},{"number":37,"text":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ"},{"number":38,"text":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ"},{"number":39,"text":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"},{"number":40,"text":"أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ"}]},{"number":76,"titleEn":"Al-Insan","titleAr":"الإنسان","verseCount":31,"startsHere":true,"verses":[{"number":1,"text":" هَلْ أَتَىٰ عَلَى ٱلْإِنسَـٰنِ حِينٌ مِّنَ ٱلدَّهْرِ لَمْ يَكُن شَيْـًٔا مَّذْكُورًا"},{"number":2,"text":"إِنَّا خَلَقْنَا ٱلْإِنسَـٰنَ مِن نُّطْفَةٍ أَمْشَاجٍ نَّبْتَلِيهِ فَجَعَلْنَـٰهُ سَمِيعًۢا بَصِيرًا"},{"number":3,"text":"إِنَّا هَدَيْنَـٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرًا وَإِمَّا كَفُورًا"},{"number":4,"text":"إِنَّآ أَعْتَدْنَا لِلْكَـٰفِرِينَ سَلَـٰسِلَا۟ وَأَغْلَـٰلًا وَسَعِيرًا"},{"number":5,"text":"إِنَّ ٱلْأَبْرَارَ يَشْرَبُونَ مِن كَأْسٍ كَانَ مِزَاجُهَا كَافُورًا"}]}]}