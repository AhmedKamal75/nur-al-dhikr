{"page":498,"juz":25,"chapters":[{"number":44,"titleEn":"Ad-Dukhan","titleAr":"الدخان","verseCount":59,"startsHere":false,"verses":[{"number":40,"text":"إِنَّ يَوْمَ ٱلْفَصْلِ مِيقَـٰتُهُمْ أَجْمَعِينَ"},{"number":41,"text":"يَوْمَ لَا يُغْنِى مَوْلًى عَن مَّوْلًى شَيْـًٔا وَلَا هُمْ يُنصَرُونَ"},{"number":42,"text":"إِلَّا مَن رَّحِمَ ٱللَّهُ ۚ إِنَّهُۥ هُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"},{"number":43,"text":"إِنَّ شَجَرَتَ ٱلزَّقُّومِ"},{"number":44,"text":"طَعَامُ ٱلْأَثِيمِ"},{"number":45,"text":"كَٱلْمُهْلِ يَغْلِى فِى ٱلْبُطُونِ"},{"number":46,"text":"كَغَلْىِ ٱلْحَمِيمِ"},{"number":47,"text":"خُذُوهُ فَٱعْتِلُوهُ إِلَىٰ سَوَآءِ ٱلْجَحِيمِ"},{"number":48,"text":"ثُمَّ صُبُّوا۟ فَوْقَ رَأْسِهِۦ مِنْ عَذَابِ ٱلْحَمِيمِ"},{"number":49,"text":"ذُقْ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْكَرِيمُ"},{"number":50,"text":"إِنَّ هَـٰذَا مَا كُنتُم بِهِۦ تَمْتَرُونَ"},{"number":51,"text":"إِنَّ ٱلْمُتَّقِينَ فِى مَقَامٍ أَمِينٍ"},{"number":52,"text":"فِى جَنَّـٰتٍ وَعُيُونٍ"},{"number":53,"text":"يَلْبَسُونَ مِن سُندُسٍ وَإِسْتَبْرَقٍ مُّتَقَـٰبِلِينَ"},{"number":54,"text":"كَذَٰلِكَ وَزَوَّجْنَـٰهُم بِحُورٍ عِينٍ"},{"number":55,"text":"يَدْعُونَ فِيهَا بِكُلِّ فَـٰكِهَةٍ ءَامِنِينَ"},{"number":56,"text":"لَا يَذُوقُونَ فِيهَا ٱلْمَوْتَ إِلَّا ٱلْمَوْتَةَ ٱلْأُولَىٰ ۖ وَوَقَىٰهُمْ عَذَابَ ٱلْجَحِيمِ"},{"number":57,"text":"فَضْلًا مِّن رَّبِّكَ ۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ"},{"number":58,"text":"فَإِنَّمَا يَسَّرْنَـٰهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ"},{"number":59,"text":"فَٱرْتَقِبْ إِنَّهُم مُّرْتَقِبُونَ"}]}]}