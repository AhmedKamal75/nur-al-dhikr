{"page":582,"juz":30,"chapters":[{"number":78,"titleEn":"An-Naba","titleAr":"النبأ","verseCount":40,"startsHere":true,"verses":[{"number":1,"text":" عَمَّ يَتَسَآءَلُونَ"},{"number":2,"text":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ"},{"number":3,"text":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ"},{"number":4,"text":"كَلَّا سَيَعْلَمُونَ"},{"number":5,"text":"ثُمَّ كَلَّا سَيَعْلَمُونَ"},{"number":6,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا"},{"number":7,"text":"وَٱلْجِبَالَ أَوْتَادًا"},{"number":8,"text":"وَخَلَقْنَـٰكُمْ أَزْوَٰجًا"},{"number":9,"text":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا"},{"number":10,"text":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا"},{"number":11,"text":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا"},{"number":12,"text":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا"},{"number":13,"text":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا"},{"number":14,"text":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا"},{"number":15,"text":"لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا"},{"number":16,"text":"وَجَنَّـٰتٍ أَلْفَافًا"},{"number":17,"text":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا"},{"number":18,"text":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا"},{"number":19,"text":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا"},{"number":20,"text":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا"},{"number":21,"text":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا"},{"number":22,"text":"لِّلطَّـٰغِينَ مَـَٔابًا"},{"number":23,"text":"لَّـٰبِثِينَ فِيهَآ أَحْقَابًا"},{"number":24,"text":"لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا"},{"number":25,"text":"إِلَّا حَمِيمًا وَغَسَّاقًا"},{"number":26,"text":"جَزَآءً وِفَاقًا"},{"number":27,"text":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا"},{"number":28,"text":"وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا كِذَّابًا"},{"number":29,"text":"وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًا"},{"number":30,"text":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا"}]}]}