{"page":583,"juz":30,"chapters":[{"number":78,"titleEn":"An-Naba","titleAr":"النبأ","verseCount":40,"startsHere":false,"verses":[{"number":31,"text":"إِنَّ لِلْمُتَّقِينَ مَفَازًا"},{"number":32,"text":"حَدَآئِقَ وَأَعْنَـٰبًا"},{"number":33,"text":"وَكَوَاعِبَ أَتْرَابًا"},{"number":34,"text":"وَكَأْسًا دِهَاقًا"},{"number":35,"text":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا"},{"number":36,"text":"جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا"},{"number":37,"text":"رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا"},{"number":38,"text":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا"},{"number":39,"text":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا"},{"number":40,"text":"إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا"}]},{"number":79,"titleEn":"An-Naziat","titleAr":"النازعات","verseCount":46,"startsHere":true,"verses":[{"number":1,"text":" وَٱلنَّـٰزِعَـٰتِ غَرْقًا"},{"number":2,"text":"وَٱلنَّـٰشِطَـٰتِ نَشْطًا"},{"number":3,"text":"وَٱلسَّـٰبِحَـٰتِ سَبْحًا"},{"number":4,"text":"فَٱلسَّـٰبِقَـٰتِ سَبْقًا"},{"number":5,"text":"فَٱلْمُدَبِّرَٰتِ أَمْرًا"},{"number":6,"text":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ"},{"number":7,"text":"تَتْبَعُهَا ٱلرَّادِفَةُ"},{"number":8,"text":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ"},{"number":9,"text":"أَبْصَـٰرُهَا خَـٰشِعَةٌ"},{"number":10,"text":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ"},{"number":11,"text":"أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً"},{"number":12,"text":"قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ"},{"number":13,"text":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ"},{"number":14,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ"},{"number":15,"text":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ"}]}]}