{"page":603,"juz":30,"chapters":[{"number":109,"titleEn":"Al-Kafirun","titleAr":"الكافرون","verseCount":6,"startsHere":true,"verses":[{"number":1,"text":" قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ"},{"number":2,"text":"لَآ أَعْبُدُ مَا تَعْبُدُونَ"},{"number":3,"text":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"},{"number":4,"text":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ"},{"number":5,"text":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"},{"number":6,"text":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ"}]},{"number":110,"titleEn":"An-Nasr","titleAr":"النصر","verseCount":3,"startsHere":true,"verses":[{"number":1,"text":" إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ"},{"number":2,"text":"وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًا"},{"number":3,"text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا"}]},{"number":111,"titleEn":"Al-Masad","titleAr":"المسد","verseCount":5,"startsHere":true,"verses":[{"number":1,"text":" تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ"},{"number":2,"text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ"},{"number":3,"text":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ"},{"number":4,"text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ"},{"number":5,"text":"فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ"}]}]}