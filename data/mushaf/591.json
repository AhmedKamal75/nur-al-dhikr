{"page":591,"juz":30,"chapters":[{"number":86,"titleEn":"At-Tariq","titleAr":"الطارق","verseCount":17,"startsHere":true,"verses":[{"number":1,"text":" وَٱلسَّمَآءِ وَٱلطَّارِقِ"},{"number":2,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ"},{"number":3,"text":"ٱلنَّجْمُ ٱلثَّاقِبُ"},{"number":4,"text":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ"},{"number":5,"text":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ"},{"number":6,"text":"خُلِقَ مِن مَّآءٍ دَافِقٍ"},{"number":7,"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ"},{"number":8,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ"},{"number":9,"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ"},{"number":10,"text":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ"},{"number":11,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ"},{"number":12,"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ"},{"number":13,"text":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ"},{"number":14,"text":"وَمَا هُوَ بِٱلْهَزْلِ"},{"number":15,"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًا"},{"number":16,"text":"وَأَكِيدُ كَيْدًا"},{"number":17,"text":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا"}]},{"number":87,"titleEn":"Al-Ala","titleAr":"الأعلى","verseCount":19,"startsHere":true,"verses":[{"number":1,"text":" سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى"},{"number":2,"text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ"},{"number":3,"text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ"},{"number":4,"text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ"},{"number":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ"},{"number":6,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ"},{"number":7,"text":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ"},{"number":8,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ"},{"number":9,"text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ"},{"number":10,"text":"سَيَذَّكَّرُ مَن يَخْشَىٰ"},{"number":11,"text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى"},{"number":12,"text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ"},{"number":13,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"},{"number":14,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ"},{"number":15,"text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ"}]}]}