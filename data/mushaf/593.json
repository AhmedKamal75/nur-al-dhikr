{"page":593,"juz":30,"chapters":[{"number":89,"titleEn":"Al-Fajr","titleAr":"الفجر","verseCount":30,"startsHere":true,"verses":[{"number":1,"text":" وَٱلْفَجْرِ"},{"number":2,"text":"وَلَيَالٍ عَشْرٍ"},{"number":3,"text":"وَٱلشَّفْعِ وَٱلْوَتْرِ"},{"number":4,"text":"وَٱلَّيْلِ إِذَا يَسْرِ"},{"number":5,"text":"هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ"},{"number":6,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"},{"number":7,"text":"إِرَمَ ذَاتِ ٱلْعِمَادِ"},{"number":8,"text":"ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ"},{"number":9,"text":"وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ"},{"number":10,"text":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ"},{"number":11,"text":"ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ"},{"number":12,"text":"فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ"},{"number":13,"text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ"},{"number":14,"text":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ"},{"number":15,"text":"فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ"},{"number":16,"text":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ"},{"number":17,"text":"كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ"},{"number":18,"text":"وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"},{"number":19,"text":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا"},{"number":20,"text":"وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا"},{"number":21,"text":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا"},{"number":22,"text":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا"},{"number":23,"text":"وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ"}]}]}