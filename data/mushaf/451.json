{"page":451,"juz":23,"chapters":[{"number":37,"titleEn":"As-Saffat","titleAr":"الصافات","verseCount":182,"startsHere":false,"verses":[{"number":127,"text":"فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ"},{"number":128,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"number":129,"text":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"},{"number":130,"text":"سَلَـٰمٌ عَلَىٰٓ إِلْ يَاسِينَ"},{"number":131,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"number":132,"text":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"},{"number":133,"text":"وَإِنَّ لُوطًا لَّمِنَ ٱلْمُرْسَلِينَ"},{"number":134,"text":"إِذْ نَجَّيْنَـٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ"},{"number":135,"text":"إِلَّا عَجُوزًا فِى ٱلْغَـٰبِرِينَ"},{"number":136,"text":"ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ"},{"number":137,"text":"وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ"},{"number":138,"text":"وَبِٱلَّيْلِ ۗ أَفَلَا تَعْقِلُونَ"},{"number":139,"text":"وَإِنَّ يُونُسَ لَمِنَ ٱلْمُرْسَلِينَ"},{"number":140,"text":"إِذْ أَبَقَ إِلَى ٱلْفُلْكِ ٱلْمَشْحُونِ"},{"number":141,"text":"فَسَاهَمَ فَكَانَ مِنَ ٱلْمُدْحَضِينَ"},{"number":142,"text":"فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌ"},{"number":143,"text":"فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ"},{"number":144,"text":"لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ"},{"number":145,"text":"۞ فَنَبَذْنَـٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌ"},{"number":146,"text":"وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةً مِّن يَقْطِينٍ"},{"number":147,"text":"وَأَرْسَلْنَـٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ"},{"number":148,"text":"فَـَٔامَنُوا۟ فَمَتَّعْنَـٰهُمْ إِلَىٰ حِينٍ"},{"number":149,"text":"فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ"},{"number":150,"text":"أَمْ خَلَقْنَا ٱلْمَلَـٰٓئِكَةَ إِنَـٰثًا وَهُمْ شَـٰهِدُونَ"},{"number":151,"text":"أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ"},{"number":152,"text":"وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَـٰذِبُونَ"},{"number":153,"text":"أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ"}]}]}