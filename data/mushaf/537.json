{"page":537,"juz":27,"chapters":[{"number":56,"titleEn":"Al-Waqia","titleAr":"الواقعة","verseCount":96,"startsHere":false,"verses":[{"number":77,"text":"إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ"},{"number":78,"text":"فِى كِتَـٰبٍ مَّكْنُونٍ"},{"number":79,"text":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ"},{"number":80,"text":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ"},{"number":81,"text":"أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ"},{"number":82,"text":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ"},{"number":83,"text":"فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ"},{"number":84,"text":"وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ"},{"number":85,"text":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ"},{"number":86,"text":"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ"},{"number":87,"text":"تَرْجِعُونَهَآ إِن كُنتُمْ صَـٰدِقِينَ"},{"number":88,"text":"فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ"},{"number":89,"text":"فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ"},{"number":90,"text":"وَأَمَّآ إِن كَانَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ"},{"number":91,"text":"فَسَلَـٰمٌ لَّكَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ"},{"number":92,"text":"وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ"},{"number":93,"text":"فَنُزُلٌ مِّنْ حَمِيمٍ"},{"number":94,"text":"وَتَصْلِيَةُ جَحِيمٍ"},{"number":95,"text":"إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ"},{"number":96,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"}]},{"number":57,"titleEn":"Al-Hadid","titleAr":"الحديد","verseCount":29,"startsHere":true,"verses":[{"number":1,"text":" سَبَّحَ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ"},{"number":2,"text":"لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ يُحْىِۦ وَيُمِيتُ ۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ"},{"number":3,"text":"هُوَ ٱلْأَوَّلُ وَٱلْـَٔاخِرُ وَٱلظَّـٰهِرُ وَٱلْبَاطِنُ ۖ وَهُوَ بِكُلِّ شَىْءٍ عَلِيمٌ"}]}]}