{"page":568,"juz":29,"chapters":[{"number":69,"titleEn":"Al-Haqqah","titleAr":"الحاقة","verseCount":52,"startsHere":false,"verses":[{"number":35,"text":"فَلَيْسَ لَهُ ٱلْيَوْمَ هَـٰهُنَا حَمِيمٌ"},{"number":36,"text":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ"},{"number":37,"text":"لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَـٰطِـُٔونَ"},{"number":38,"text":"فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ"},{"number":39,"text":"وَمَا لَا تُبْصِرُونَ"},{"number":40,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ"},{"number":41,"text":"وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَّا تُؤْمِنُونَ"},{"number":42,"text":"وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ"},{"number":43,"text":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ"},{"number":44,"text":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ"},{"number":45,"text":"لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ"},{"number":46,"text":"ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ"},{"number":47,"text":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَـٰجِزِينَ"},{"number":48,"text":"وَإِنَّهُۥ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ"},{"number":49,"text":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ"},{"number":50,"text":"وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَـٰفِرِينَ"},{"number":51,"text":"وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ"},{"number":52,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"}]},{"number":70,"titleEn":"Al-Ma'arij","titleAr":"المعارج","verseCount":44,"startsHere":true,"verses":[{"number":1,"text":" سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ"},{"number":2,"text":"لِّلْكَـٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ"},{"number":3,"text":"مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ"},{"number":4,"text":"تَعْرُجُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ"},{"number":5,"text":"فَٱصْبِرْ صَبْرًا جَمِيلًا"},{"number":6,"text":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا"},{"number":7,"text":"وَنَرَىٰهُ قَرِيبًا"},{"number":8,"text":"يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ"},{"number":9,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ"},{"number":10,"text":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا"}]}]}