{"page":601,"juz":30,"chapters":[{"number":103,"titleEn":"Al-Asr","titleAr":"العصر","verseCount":3,"startsHere":true,"verses":[{"number":1,"text":" وَٱلْعَصْرِ"},{"number":2,"text":"إِنَّ ٱلْإِنسَـٰنَ لَفِى خُسْرٍ"},{"number":3,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ"}]},{"number":104,"titleEn":"Al-Humazah","titleAr":"الهمزة","verseCount":9,"startsHere":true,"verses":[{"number":1,"text":" وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ"},{"number":2,"text":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ"},{"number":3,"text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"},{"number":4,"text":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ"},{"number":5,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ"},{"number":6,"text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ"},{"number":7,"text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ"},{"number":8,"text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ"},{"number":9,"text":"فِى عَمَدٍ مُّمَدَّدَةٍۭ"}]},{"number":105,"titleEn":"Al-Fil","titleAr":"الفيل","verseCount":5,"startsHere":true,"verses":[{"number":1,"text":" أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ"},{"number":2,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ"},{"number":3,"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"},{"number":4,"text":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ"},{"number":5,"text":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ"}]}]}