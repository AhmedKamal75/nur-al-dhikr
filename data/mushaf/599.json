{"page":599,"juz":30,"chapters":[{"number":98,"titleEn":"Al-Bayinah","titleAr":"البينة","verseCount":8,"startsHere":false,"verses":[{"number":8,"text":"جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّـٰتُ عَدْنٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ أَبَدًا ۖ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُ ۚ ذَٰلِكَ لِمَنْ خَشِىَ رَبَّهُۥ"}]},{"number":99,"titleEn":"Az-Zalzalah","titleAr":"الزلزلة","verseCount":8,"startsHere":true,"verses":[{"number":1,"text":" إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا"},{"number":2,"text":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا"},{"number":3,"text":"وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا"},{"number":4,"text":"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا"},{"number":5,"text":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا"},{"number":6,"text":"يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَـٰلَهُمْ"},{"number":7,"text":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ"},{"number":8,"text":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ"}]},{"number":100,"titleEn":"Al-Adiyat","titleAr":"العاديات","verseCount":11,"startsHere":true,"verses":[{"number":1,"text":" وَٱلْعَـٰدِيَـٰتِ ضَبْحًا"},{"number":2,"text":"فَٱلْمُورِيَـٰتِ قَدْحًا"},{"number":3,"text":"فَٱلْمُغِيرَٰتِ صُبْحًا"},{"number":4,"text":"فَأَثَرْنَ بِهِۦ نَقْعًا"},{"number":5,"text":"فَوَسَطْنَ بِهِۦ جَمْعًا"},{"number":6,"text":"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ"},{"number":7,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ"},{"number":8,"text":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ"},{"number":9,"text":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ"}]}]}