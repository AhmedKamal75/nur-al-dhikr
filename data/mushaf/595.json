{"page":595,"juz":30,"chapters":[{"number":91,"titleEn":"Ash-Shams","titleAr":"الشمس","verseCount":15,"startsHere":true,"verses":[{"number":1,"text":" وَٱلشَّمْسِ وَضُحَىٰهَا"},{"number":2,"text":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا"},{"number":3,"text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا"},{"number":4,"text":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا"},{"number":5,"text":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا"},{"number":6,"text":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا"},{"number":7,"text":"وَنَفْسٍ وَمَا سَوَّىٰهَا"},{"number":8,"text":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا"},{"number":9,"text":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا"},{"number":10,"text":"وَقَدْ خَابَ مَن دَسَّىٰهَا"},{"number":11,"text":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ"},{"number":12,"text":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا"},{"number":13,"text":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا"},{"number":14,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا"},{"number":15,"text":"وَلَا يَخَافُ عُقْبَـٰهَا"}]},{"number":92,"titleEn":"Al-Lail","titleAr":"الليل","verseCount":21,"startsHere":true,"verses":[{"number":1,"text":" وَٱلَّيْلِ إِذَا يَغْشَىٰ"},{"number":2,"text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"},{"number":3,"text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"},{"number":4,"text":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ"},{"number":5,"text":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ"},{"number":6,"text":"وَصَدَّقَ بِٱلْحُسْنَىٰ"},{"number":7,"text":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ"},{"number":8,"text":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ"},{"number":9,"text":"وَكَذَّبَ بِٱلْحُسْنَىٰ"},{"number":10,"text":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ"},{"number":11,"text":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"},{"number":12,"text":"إِنَّ عَلَيْنَا لَلْهُدَىٰ"},{"number":13,"text":"وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ"},{"number":14,"text":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ"}]}]}