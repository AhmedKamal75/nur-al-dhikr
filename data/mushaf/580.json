{"page":580,"juz":29,"chapters":[{"number":76,"titleEn":"Al-Insan","titleAr":"الإنسان","verseCount":31,"startsHere":false,"verses":[{"number":26,"text":"وَمِنَ ٱلَّيْلِ فَٱسْجُدْ لَهُۥ وَسَبِّحْهُ لَيْلًا طَوِيلًا"},{"number":27,"text":"إِنَّ هَـٰٓؤُلَآءِ يُحِبُّونَ ٱلْعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمْ يَوْمًا ثَقِيلًا"},{"number":28,"text":"نَّحْنُ خَلَقْنَـٰهُمْ وَشَدَدْنَآ أَسْرَهُمْ ۖ وَإِذَا شِئْنَا بَدَّلْنَآ أَمْثَـٰلَهُمْ تَبْدِيلًا"},{"number":29,"text":"إِنَّ هَـٰذِهِۦ تَذْكِرَةٌ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا"},{"number":30,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًا"},{"number":31,"text":"يُدْخِلُ مَن يَشَآءُ فِى رَحْمَتِهِۦ ۚ وَٱلظَّـٰلِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًۢا"}]},{"number":77,"titleEn":"Al-Mursalat","titleAr":"المرسلات","verseCount":50,"startsHere":true,"verses":[{"number":1,"text":" وَٱلْمُرْسَلَـٰتِ عُرْفًا"},{"number":2,"text":"فَٱلْعَـٰصِفَـٰتِ عَصْفًا"},{"number":3,"text":"وَٱلنَّـٰشِرَٰتِ نَشْرًا"},{"number":4,"text":"فَٱلْفَـٰرِقَـٰتِ فَرْقًا"},{"number":5,"text":"فَٱلْمُلْقِيَـٰتِ ذِكْرًا"},{"number":6,"text":"عُذْرًا أَوْ نُذْرًا"},{"number":7,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ"},{"number":8,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ"},{"number":9,"text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ"},{"number":10,"text":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ"},{"number":11,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ"},{"number":12,"text":"لِأَىِّ يَوْمٍ أُجِّلَتْ"},{"number":13,"text":"لِيَوْمِ ٱلْفَصْلِ"},{"number":14,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ"},{"number":15,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"number":16,"text":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ"},{"number":17,"text":"ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ"},{"number":18,"text":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"},{"number":19,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"}]}]}