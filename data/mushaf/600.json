{"page":600,"juz":30,"chapters":[{"number":100,"titleEn":"Al-Adiyat","titleAr":"العاديات","verseCount":11,"startsHere":false,"verses":[{"number":10,"text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ"},{"number":11,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ"}]},{"number":101,"titleEn":"Al-Qariah","titleAr":"القارعة","verseCount":11,"startsHere":true,"verses":[{"number":1,"text":" ٱلْقَارِعَةُ"},{"number":2,"text":"مَا ٱلْقَارِعَةُ"},{"number":3,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ"},{"number":4,"text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ"},{"number":5,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ"},{"number":6,"text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ"},{"number":7,"text":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ"},{"number":8,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ"},{"number":9,"text":"فَأُمُّهُۥ هَاوِيَةٌ"},{"number":10,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ"},{"number":11,"text":"نَارٌ حَامِيَةٌۢ"}]},{"number":102,"titleEn":"Al-Takathur","titleAr":"التكاثر","verseCount":8,"startsHere":true,"verses":[{"number":1,"text":" أَلْهَىٰكُمُ ٱلتَّكَاثُرُ"},{"number":2,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ"},{"number":3,"text":"كَلَّا سَوْفَ تَعْلَمُونَ"},{"number":4,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ"},{"number":5,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ"},{"number":6,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ"},{"number":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ"},{"number":8,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ"}]}]}