{"page":602,"juz":30,"chapters":[{"number":106,"titleEn":"Quraish","titleAr":"قريش","verseCount":4,"startsHere":true,"verses":[{"number":1,"text":" لِإِيلَـٰفِ قُرَيْشٍ"},{"number":2,"text":"إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ"},{"number":3,"text":"فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا ٱلْبَيْتِ"},{"number":4,"text":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ"}]},{"number":107,"titleEn":"Al-Ma'un","titleAr":"الماعون","verseCount":7,"startsHere":true,"verses":[{"number":1,"text":" أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"},{"number":2,"text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"},{"number":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"},{"number":4,"text":"فَوَيْلٌ لِّلْمُصَلِّينَ"},{"number":5,"text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"},{"number":6,"text":"ٱلَّذِينَ هُمْ يُرَآءُونَ"},{"number":7,"text":"وَيَمْنَعُونَ ٱلْمَاعُونَ"}]},{"number":108,"titleEn":"Al-Kauthar","titleAr":"الكوثر","verseCount":3,"startsHere":true,"verses":[{"number":1,"text":" إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ"},{"number":2,"text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ"},{"number":3,"text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ"}]}]}