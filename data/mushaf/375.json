{"page":375,"juz":19,"chapters":[{"number":26,"titleEn":"Ash-Shuara","titleAr":"الشعراء","verseCount":227,"startsHere":false,"verses":[{"number":184,"text":"وَٱتَّقُوا۟ ٱلَّذِى خَلَقَكُمْ وَٱلْجِبِلَّةَ ٱلْأَوَّلِينَ"},{"number":185,"text":"قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ"},{"number":186,"text":"وَمَآ أَنتَ إِلَّا بَشَرٌ مِّثْلُنَا وَإِن نَّظُنُّكَ لَمِنَ ٱلْكَـٰذِبِينَ"},{"number":187,"text":"فَأَسْقِطْ عَلَيْنَا كِسَفًا مِّنَ ٱلسَّمَآءِ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ"},{"number":188,"text":"قَالَ رَبِّىٓ أَعْلَمُ بِمَا تَعْمَلُونَ"},{"number":189,"text":"فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ ٱلظُّلَّةِ ۚ إِنَّهُۥ كَانَ عَذَابَ يَوْمٍ عَظِيمٍ"},{"number":190,"text":"إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"},{"number":191,"text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"},{"number":192,"text":"وَإِنَّهُۥ لَتَنزِيلُ رَبِّ ٱلْعَـٰلَمِينَ"},{"number":193,"text":"نَزَلَ بِهِ ٱلرُّوحُ ٱلْأَمِينُ"},{"number":194,"text":"عَلَىٰ قَلْبِكَ لِتَكُونَ مِنَ ٱلْمُنذِرِينَ"},{"number":195,"text":"بِلِسَانٍ عَرَبِىٍّ مُّبِينٍ"},{"number":196,"text":"وَإِنَّهُۥ لَفِى زُبُرِ ٱلْأَوَّلِينَ"},{"number":197,"text":"أَوَلَمْ يَكُن لَّهُمْ ءَايَةً أَن يَعْلَمَهُۥ عُلَمَـٰٓؤُا۟ بَنِىٓ إِسْرَٰٓءِيلَ"},{"number":198,"text":"وَلَوْ نَزَّلْنَـٰهُ عَلَىٰ بَعْضِ ٱلْأَعْجَمِينَ"},{"number":199,"text":"فَقَرَأَهُۥ عَلَيْهِم مَّا كَانُوا۟ بِهِۦ مُؤْمِنِينَ"},{"number":200,"text":"كَذَٰلِكَ سَلَكْنَـٰهُ فِى قُلُوبِ ٱلْمُجْرِمِينَ"},{"number":201,"text":"لَا يُؤْمِنُونَ بِهِۦ حَتَّىٰ يَرَوُا۟ ٱلْعَذَابَ ٱلْأَلِيمَ"},{"number":202,"text":"فَيَأْتِيَهُم بَغْتَةً وَهُمْ لَا يَشْعُرُونَ"},{"number":203,"text":"فَيَقُولُوا۟ هَلْ نَحْنُ مُنظَرُونَ"},{"number":204,"text":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"},{"number":205,"text":"أَفَرَءَيْتَ إِن مَّتَّعْنَـٰهُمْ سِنِينَ"},{"number":206,"text":"ثُمَّ جَآءَهُم مَّا كَانُوا۟ يُوعَدُونَ"}]}]}