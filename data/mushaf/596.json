{"page":596,"juz":30,"chapters":[{"number":92,"titleEn":"Al-Lail","titleAr":"الليل","verseCount":21,"startsHere":false,"verses":[{"number":15,"text":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى"},{"number":16,"text":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ"},{"number":17,"text":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى"},{"number":18,"text":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ"},{"number":19,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ"},{"number":20,"text":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ"},{"number":21,"text":"وَلَسَوْفَ يَرْضَىٰ"}]},{"number":93,"titleEn":"Ad-Duha","titleAr":"الضحى","verseCount":11,"startsHere":true,"verses":[{"number":1,"text":" وَٱلضُّحَىٰ"},{"number":2,"text":"وَٱلَّيْلِ إِذَا سَجَىٰ"},{"number":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"},{"number":4,"text":"وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ"},{"number":5,"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ"},{"number":6,"text":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ"},{"number":7,"text":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ"},{"number":8,"text":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ"},{"number":9,"text":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ"},{"number":10,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ"},{"number":11,"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"}]},{"number":94,"titleEn":"Ash-Sharh","titleAr":"الشرح","verseCount":8,"startsHere":true,"verses":[{"number":1,"text":" أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ"},{"number":2,"text":"وَوَضَعْنَا عَنكَ وِزْرَكَ"},{"number":3,"text":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ"},{"number":4,"text":"وَرَفَعْنَا لَكَ ذِكْرَكَ"},{"number":5,"text":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا"},{"number":6,"text":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا"},{"number":7,"text":"فَإِذَا فَرَغْتَ فَٱنصَبْ"},{"number":8,"text":"وَإِلَىٰ رَبِّكَ فَٱرْغَب"}]}]}