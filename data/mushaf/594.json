{"page":594,"juz":30,"chapters":[{"number":89,"titleEn":"Al-Fajr","titleAr":"الفجر","verseCount":30,"startsHere":false,"verses":[{"number":24,"text":"يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى"},{"number":25,"text":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ"},{"number":26,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ"},{"number":27,"text":"يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ"},{"number":28,"text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً"},{"number":29,"text":"فَٱدْخُلِى فِى عِبَـٰدِى"},{"number":30,"text":"وَٱدْخُلِى جَنَّتِى"}]},{"number":90,"titleEn":"Al-Balad","titleAr":"البلد","verseCount":20,"startsHere":true,"verses":[{"number":1,"text":" لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ"},{"number":2,"text":"وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ"},{"number":3,"text":"وَوَالِدٍ وَمَا وَلَدَ"},{"number":4,"text":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ"},{"number":5,"text":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ"},{"number":6,"text":"يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا"},{"number":7,"text":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ"},{"number":8,"text":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"},{"number":9,"text":"وَلِسَانًا وَشَفَتَيْنِ"},{"number":10,"text":"وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ"},{"number":11,"text":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ"},{"number":12,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ"},{"number":13,"text":"فَكُّ رَقَبَةٍ"},{"number":14,"text":"أَوْ إِطْعَـٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ"},{"number":15,"text":"يَتِيمًا ذَا مَقْرَبَةٍ"},{"number":16,"text":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ"},{"number":17,"text":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ"},{"number":18,"text":"أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ"},{"number":19,"text":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ"},{"number":20,"text":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ"}]}]}