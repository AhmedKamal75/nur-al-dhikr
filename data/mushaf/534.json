{"page":534,"juz":27,"chapters":[{"number":55,"titleEn":"Ar-Rahman","titleAr":"الرحمن","verseCount":78,"startsHere":false,"verses":[{"number":68,"text":"فِيهِمَا فَـٰكِهَةٌ وَنَخْلٌ وَرُمَّانٌ"},{"number":69,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":70,"text":"فِيهِنَّ خَيْرَٰتٌ حِسَانٌ"},{"number":71,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":72,"text":"حُورٌ مَّقْصُورَٰتٌ فِى ٱلْخِيَامِ"},{"number":73,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":74,"text":"لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ"},{"number":75,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":76,"text":"مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍ وَعَبْقَرِىٍّ حِسَانٍ"},{"number":77,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"number":78,"text":"تَبَـٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ"}]},{"number":56,"titleEn":"Al-Waqia","titleAr":"الواقعة","verseCount":96,"startsHere":true,"verses":[{"number":1,"text":" إِذَا وَقَعَتِ ٱلْوَاقِعَةُ"},{"number":2,"text":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ"},{"number":3,"text":"خَافِضَةٌ رَّافِعَةٌ"},{"number":4,"text":"إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا"},{"number":5,"text":"وَبُسَّتِ ٱلْجِبَالُ بَسًّا"},{"number":6,"text":"فَكَانَتْ هَبَآءً مُّنۢبَثًّا"},{"number":7,"text":"وَكُنتُمْ أَزْوَٰجًا ثَلَـٰثَةً"},{"number":8,"text":"فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ"},{"number":9,"text":"وَأَصْحَـٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ"},{"number":10,"text":"وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ"},{"number":11,"text":"أُو۟لَـٰٓئِكَ ٱلْمُقَرَّبُونَ"},{"number":12,"text":"فِى جَنَّـٰتِ ٱلنَّعِيمِ"},{"number":13,"text":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ"},{"number":14,"text":"وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ"},{"number":15,"text":"عَلَىٰ سُرُرٍ مَّوْضُونَةٍ"},{"number":16,"text":"مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَـٰبِلِينَ"}]}]}