{"page":536,"juz":27,"chapters":[{"number":56,"titleEn":"Al-Waqia","titleAr":"الواقعة","verseCount":96,"startsHere":false,"verses":[{"number":51,"text":"ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ"},{"number":52,"text":"لَـَٔاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ"},{"number":53,"text":"فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ"},{"number":54,"text":"فَشَـٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ"},{"number":55,"text":"فَشَـٰرِبُونَ شُرْبَ ٱلْهِيمِ"},{"number":56,"text":"هَـٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ"},{"number":57,"text":"نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا تُصَدِّقُونَ"},{"number":58,"text":"أَفَرَءَيْتُم مَّا تُمْنُونَ"},{"number":59,"text":"ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَـٰلِقُونَ"},{"number":60,"text":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ"},{"number":61,"text":"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ"},{"number":62,"text":"وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ"},{"number":63,"text":"أَفَرَءَيْتُم مَّا تَحْرُثُونَ"},{"number":64,"text":"ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ"},{"number":65,"text":"لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ"},{"number":66,"text":"إِنَّا لَمُغْرَمُونَ"},{"number":67,"text":"بَلْ نَحْنُ مَحْرُومُونَ"},{"number":68,"text":"أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ"},{"number":69,"text":"ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ"},{"number":70,"text":"لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ"},{"number":71,"text":"أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ"},{"number":72,"text":"ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ"},{"number":73,"text":"نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةً وَمَتَـٰعًا لِّلْمُقْوِينَ"},{"number":74,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"},{"number":75,"text":"۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ"},{"number":76,"text":"وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ"}]}]}