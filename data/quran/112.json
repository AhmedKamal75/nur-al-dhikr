{"number": 112, "nameAr": "الإخلاص", "nameEn": "Al-Ikhlas", "nameTransliteration": "Al-Ikhlāṣ", "revelationType": "Meccan", "ayahs": [{"number": 1, "text": "قُلۡ هُوَ ٱللَّهُ أَحَدٌ", "translation": "Say, \"He is Allah, [who is] One"}, {"number": 2, "text": "ٱللَّهُ ٱلصَّمَدُ", "translation": "Allah, the Eternal Refuge"}, {"number": 3, "text": "لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ", "translation": "He neither begets nor is born"}, {"number": 4, "text": "وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ", "translation": "Nor is there to Him any equivalent"}]}