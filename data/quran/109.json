{"number": 109, "nameAr": "الكافرون", "nameEn": "Al-Kafirun", "nameTransliteration": "Al-Kāfirūn", "revelationType": "Meccan", "ayahs": [{"number": 1, "text": "قُلۡ يَـٰٓأَيُّهَا ٱلۡكَٰفِرُونَ", "translation": "Say, \"O disbelievers"}, {"number": 2, "text": "لَآ أَعۡبُدُ مَا تَعۡبُدُونَ", "translation": "I do not worship what you worship"}, {"number": 3, "text": "وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ", "translation": "Nor are you worshippers of what I worship"}, {"number": 4, "text": "وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ", "translation": "Nor will I be a worshipper of what you worship"}, {"number": 5, "text": "وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ", "translation": "Nor will you be worshippers of what I worship"}, {"number": 6, "text": "لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ", "translation": "For you is your religion, and for me is my religion"}]}